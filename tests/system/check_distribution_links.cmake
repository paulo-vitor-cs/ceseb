cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED CESEB_APP_ROOT OR NOT IS_DIRECTORY "${CESEB_APP_ROOT}/docs")
  message(FATAL_ERROR "UNAVAILABLE: CESEB_APP_ROOT must identify a real extracted application tree")
endif()
file(REAL_PATH "${CESEB_APP_ROOT}" app_root)
set(failures "")
foreach(required README.md user-guide.md build-and-test.md technical-report.md)
  if(NOT EXISTS "${app_root}/docs/${required}")
    list(APPEND failures "Required delivered document absent: docs/${required}")
  endif()
endforeach()
file(GLOB_RECURSE documents LIST_DIRECTORIES FALSE "${app_root}/docs/*.md")
set(index_documents "")
set(index_licenses "")
set(evidence_links 0)
set(local_links 0)
foreach(document IN LISTS documents)
  file(READ "${document}" body)
  get_filename_component(base_directory "${document}" DIRECTORY)
  # This intentionally supports the inline, space-free link syntax used by docs/.
  string(REGEX MATCHALL "\\[[^]\r\n]+\\]\\([^ \t\r\n)]+\\)" links "${body}")
  foreach(link IN LISTS links)
    string(REGEX REPLACE "^.*\\]\\(([^)]+)\\)$" "\\1" reference "${link}")
    if(reference MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:" OR reference MATCHES "^#")
      continue()
    endif()
    string(REGEX REPLACE "[#?].*$" "" reference "${reference}")
    if(reference STREQUAL "")
      continue()
    endif()
    math(EXPR local_links "${local_links}+1")
    get_filename_component(target "${reference}" ABSOLUTE BASE_DIR "${base_directory}")
    file(RELATIVE_PATH source_name "${app_root}" "${document}")
    if(NOT EXISTS "${target}" OR IS_DIRECTORY "${target}")
      list(APPEND failures "${source_name}: missing local target ${reference}")
      continue()
    endif()
    file(REAL_PATH "${target}" resolved_target)
    string(FIND "${resolved_target}" "${app_root}/" inside)
    if(NOT inside EQUAL 0)
      list(APPEND failures "${source_name}: target outside delivered application tree: ${reference}")
      continue()
    endif()
    get_filename_component(target_name "${target}" NAME)
    if(document STREQUAL "${app_root}/docs/README.md")
      if(target_name MATCHES "^(user-guide|build-and-test|technical-report)\\.md$")
        list(APPEND index_documents "${target_name}")
      elseif(target_name STREQUAL "LICENSE" OR target_name STREQUAL "THIRD_PARTY_NOTICES.md")
        list(APPEND index_licenses "${target_name}")
      endif()
    endif()
    if(document STREQUAL "${app_root}/docs/technical-report.md" AND
       NOT resolved_target STREQUAL document AND
       (target_name MATCHES "\\.(json|log|xml)$" OR reference MATCHES "(^|/)evidence/.*\\.md$"))
      math(EXPR evidence_links "${evidence_links}+1")
    endif()
    message(STATUS "Resolved ${source_name}: ${reference}")
  endforeach()
endforeach()
list(REMOVE_DUPLICATES index_documents)
list(REMOVE_DUPLICATES index_licenses)
list(LENGTH index_documents document_count)
list(LENGTH index_licenses license_count)
if(NOT document_count EQUAL 3 OR NOT license_count EQUAL 2)
  list(APPEND failures "README index lacks three recoverable document links and two recoverable original/third-party license links")
endif()
if(evidence_links LESS 1)
  list(APPEND failures "technical-report.md has no recoverable local execution-evidence link (JSON/log/XML or evidence Markdown)")
endif()
foreach(failure IN LISTS failures)
  message(STATUS "FAIL 1227: ${failure}")
endforeach()
if(failures)
  message(FATAL_ERROR "FAIL 1227: delivered documentation links/evidence are not fully recoverable")
endif()
message(STATUS "PASS: ${local_links} local Markdown links, ${evidence_links} report evidence links recovered; claim truth requires separate inspection")
