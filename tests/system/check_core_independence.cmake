cmake_minimum_required(VERSION 3.28)
foreach(required CESEB_SOURCE_ROOT CESEB_BINARY_ROOT CESEB_BOOST_ROOT CESEB_GTEST_PREFIX CESEB_CXX_COMPILER)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "UNAVAILABLE: ${required} must identify the qualified source/environment")
  endif()
endforeach()
if(NOT EXISTS "${CESEB_SOURCE_ROOT}/CMakeLists.txt" OR NOT EXISTS "${CESEB_SOURCE_ROOT}/include/ceseb/finance.hpp")
  message(FATAL_ERROR "UNAVAILABLE: real product CMake/API absent; no substitute core is created")
endif()
if(NOT EXISTS "${CESEB_SOURCE_ROOT}/.git" AND (NOT DEFINED CESEB_SOURCE_REVISION OR CESEB_SOURCE_REVISION STREQUAL ""))
  message(FATAL_ERROR "UNAVAILABLE: exported source requires its real CESEB_SOURCE_REVISION")
endif()
file(REAL_PATH "${CESEB_SOURCE_ROOT}" source_root)
file(REAL_PATH "${CESEB_BINARY_ROOT}" binary_root)
if(source_root STREQUAL binary_root)
  message(FATAL_ERROR "Refusing an in-source isolation build")
endif()
file(MAKE_DIRECTORY "${CESEB_BINARY_ROOT}")
set(configure_args -S "${CESEB_SOURCE_ROOT}" -B "${CESEB_BINARY_ROOT}" -G Ninja
  -DCMAKE_BUILD_TYPE=Release -DCESEB_BUILD_GUI=OFF -DCESEB_BUILD_TESTS=ON
  -DCMAKE_DISABLE_FIND_PACKAGE_Qt6=TRUE
  "-DCMAKE_CXX_COMPILER=${CESEB_CXX_COMPILER}"
  "-DCESEB_BOOST_ROOT=${CESEB_BOOST_ROOT}"
  "-DCMAKE_PREFIX_PATH=${CESEB_GTEST_PREFIX}")
if(DEFINED CESEB_SOURCE_REVISION AND NOT CESEB_SOURCE_REVISION STREQUAL "")
  list(APPEND configure_args "-DCESEB_SOURCE_REVISION=${CESEB_SOURCE_REVISION}")
endif()
if(DEFINED CMAKE_MAKE_PROGRAM AND NOT CMAKE_MAKE_PROGRAM STREQUAL "")
  list(APPEND configure_args "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${configure_args} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${CESEB_BINARY_ROOT}/isolation-configure.log" "${output}\n${error}")
if(NOT code STREQUAL "0")
  message(FATAL_ERROR "Core-only configure unavailable/failed (${code}); see isolation-configure.log. Not behavioral RED.")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${CESEB_BINARY_ROOT}" --target ceseb_domain_tests --parallel
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${CESEB_BINARY_ROOT}/isolation-build.log" "${output}\n${error}")
if(NOT code STREQUAL "0")
  message(FATAL_ERROR "Core-only build failed (${code}); see isolation-build.log. Not a behavioral result.")
endif()
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(ctest_program NAMES ctest HINTS "${cmake_bin}" REQUIRED)
execute_process(COMMAND "${ctest_program}" --test-dir "${CESEB_BINARY_ROOT}" -C Release -L domain
  --output-on-failure --no-tests=error --output-junit "${CESEB_BINARY_ROOT}/results.xml"
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${CESEB_BINARY_ROOT}/isolation-tests.log" "${output}\n${error}")
if(NOT code STREQUAL "0")
  message(FATAL_ERROR "Core-only domain execution failed (${code}); preserve exact cases/results")
endif()
file(GLOB_RECURSE financial_sources "${CESEB_SOURCE_ROOT}/include/ceseb/*.hpp" "${CESEB_SOURCE_ROOT}/src/core/*.hpp" "${CESEB_SOURCE_ROOT}/src/core/*.cpp")
foreach(source IN LISTS financial_sources)
  file(READ "${source}" content)
  if(content MATCHES "#[ \t]*include[ \t]*[<\"](Qt|Q[A-Z])")
    message(FATAL_ERROR "Unexpected direct Qt include in core: ${source}")
  endif()
endforeach()
message(STATUS "Core-only configure/build/domain execution completed with Qt6 package discovery disabled. Actual installed-environment absence and native qualification are recorded separately.")
