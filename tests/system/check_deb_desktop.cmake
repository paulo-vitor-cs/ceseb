cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED CESEB_PACKAGE_ROOT OR NOT IS_DIRECTORY "${CESEB_PACKAGE_ROOT}/opt/ceseb")
  message(FATAL_ERROR "UNAVAILABLE: CESEB_PACKAGE_ROOT must identify an extracted real DEB")
endif()
file(REAL_PATH "${CESEB_PACKAGE_ROOT}" package_root)
set(found FALSE)
foreach(directory usr/share/applications usr/local/share/applications)
  set(launcher "${package_root}/${directory}/ceseb.desktop")
  if(NOT EXISTS "${launcher}")
    continue()
  endif()
  set(found TRUE)
  file(STRINGS "${launcher}" lines)
  set(section FALSE)
  set(application FALSE)
  set(executable "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^\\[.*\\]$")
      if(line STREQUAL "[Desktop Entry]")
        set(section TRUE)
      else()
        set(section FALSE)
      endif()
    elseif(section AND line STREQUAL "Type=Application")
      set(application TRUE)
    elseif(section AND line MATCHES "^Exec=(/[^ \t]+)([ \t].*)?$")
      set(executable "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT application OR executable STREQUAL "")
    message(FATAL_ERROR "FAIL 1225: ${launcher} lacks a usable Application/absolute Exec entry")
  endif()
  set(target "${package_root}${executable}")
  if(NOT EXISTS "${target}" OR IS_DIRECTORY "${target}")
    message(FATAL_ERROR "FAIL 1225: published desktop Exec target absent from DEB: ${executable}")
  endif()
  file(REAL_PATH "${target}" resolved_target)
  string(FIND "${resolved_target}" "${package_root}/" inside)
  if(NOT inside EQUAL 0)
    message(FATAL_ERROR "FAIL 1225: desktop Exec escapes the extracted package: ${executable}")
  endif()
  message(STATUS "1225 desktop entry: ${directory}/ceseb.desktop -> ${executable}")
endforeach()
if(NOT found)
  message(FATAL_ERROR "FAIL 1225: ceseb.desktop absent from default XDG applications directories (usr/share/applications and usr/local/share/applications)")
endif()
message(STATUS "PASS: DEB desktop inventory regression; no menu launch or clean installation inferred")
