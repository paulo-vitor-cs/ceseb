cmake_minimum_required(VERSION 3.28)
# Explicit preparation command; normal configure/build never downloads legal materials.
foreach(_required CESEB_DEPS_ROOT CESEB_QT_ROOT)
  if(NOT DEFINED ${_required})
    message(FATAL_ERROR "${_required} must identify the acquired local dependency prefix")
  endif()
endforeach()
get_filename_component(CESEB_DEPS_ROOT "${CESEB_DEPS_ROOT}" ABSOLUTE)
get_filename_component(CESEB_QT_ROOT "${CESEB_QT_ROOT}" ABSOLUTE)
if(NOT EXISTS "${CESEB_DEPS_ROOT}/.ceseb-owned")
  message(FATAL_ERROR "Prepare notices only inside the owned acquired dependency cache")
endif()
set(_revision 025bdad181de241e81bf853c8a2d7bf3d19261a9)
set(_sbom "${CESEB_QT_ROOT}/sbom/qtbase-6.12.0.spdx.json")
file(READ "${_sbom}" _sbom_json)
string(JSON _source GET "${_sbom_json}" packages 0 downloadLocation)
if(NOT _source STREQUAL "git://code.qt.io/qt/qtbase.git@${_revision}")
  message(FATAL_ERROR "Qt source correspondence differs from the inspected SDK: ${_source}")
endif()
find_program(_git NAMES git REQUIRED)
set(_qt_source "${CESEB_DEPS_ROOT}/qtbase-src")
if(EXISTS "${_qt_source}" AND NOT EXISTS "${_qt_source}/.git")
  message(FATAL_ERROR "Preserving unrecognized Qt source directory")
endif()
if(NOT EXISTS "${_qt_source}/.git")
  file(MAKE_DIRECTORY "${_qt_source}")
  execute_process(COMMAND "${_git}" -C "${_qt_source}" init COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_TERMINAL_PROMPT=0
    "${_git}" -C "${_qt_source}" -c http.sslVerify=true fetch --depth=1 --no-tags
    https://code.qt.io/qt/qtbase.git "${_revision}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${_git}" -C "${_qt_source}" checkout --detach "${_revision}" COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND "${_git}" -C "${_qt_source}" rev-parse HEAD OUTPUT_VARIABLE _actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${_git}" -C "${_qt_source}" status --porcelain OUTPUT_VARIABLE _dirty COMMAND_ERROR_IS_FATAL ANY)
if(NOT _actual STREQUAL _revision OR NOT _dirty STREQUAL "")
  message(FATAL_ERROR "Qt corresponding source must be the exact unmodified SDK source commit")
endif()
set(_out "${CESEB_DEPS_ROOT}/notices")
file(MAKE_DIRECTORY "${_out}/qtbase/thirdparty" "${_out}/source")
file(COPY "${_qt_source}/LICENSES" DESTINATION "${_out}/qtbase")
file(COPY "${CESEB_QT_ROOT}/sbom" DESTINATION "${_out}/qtbase")
foreach(_config config_qtbase.opt config_qtbase.summary)
  file(COPY "${CESEB_QT_ROOT}/${_config}" DESTINATION "${_out}/qtbase")
endforeach()
file(GLOB_RECURSE _thirdparty RELATIVE "${_qt_source}/src/3rdparty" "${_qt_source}/src/3rdparty/*")
foreach(_entry IN LISTS _thirdparty)
  if(_entry MATCHES "(^|/)(LICENSE[^/]*|COPYING[^/]*|COPYRIGHT[^/]*|NOTICE[^/]*|qt_attribution.json)$")
    get_filename_component(_parent "${_entry}" DIRECTORY)
    file(MAKE_DIRECTORY "${_out}/qtbase/thirdparty/${_parent}")
    file(COPY "${_qt_source}/src/3rdparty/${_entry}" DESTINATION "${_out}/qtbase/thirdparty/${_parent}")
  endif()
endforeach()
execute_process(COMMAND "${_git}" -C "${_qt_source}" archive --format=tar.gz
  "--prefix=qtbase-${_revision}/" "--output=${_out}/source/qtbase-${_revision}.tar.gz" "${_revision}" COMMAND_ERROR_IS_FATAL ANY)
file(COPY_FILE "${CESEB_DEPS_ROOT}/boost_1_86_0/LICENSE_1_0.txt" "${_out}/boost-LICENSE_1_0.txt")
file(COPY_FILE "${CESEB_DEPS_ROOT}/googletest-src/LICENSE" "${_out}/googletest-LICENSE.txt")
# ICU 73.2 is the version actually recorded by the selected Linux SDK SBOM.
file(DOWNLOAD https://raw.githubusercontent.com/unicode-org/icu/release-73-2/icu4c/LICENSE
  "${_out}/icu-LICENSE.txt.part" TLS_VERIFY ON NETRC IGNORED
  EXPECTED_HASH SHA256=f3005e195ff74d8812cc1f182a1c446fab678d70a10e3dada497585befee5416
  STATUS _status TIMEOUT 120)
list(GET _status 0 _code)
if(NOT _code EQUAL 0)
  message(FATAL_ERROR "ICU license retrieval failed: ${_status}")
endif()
file(RENAME "${_out}/icu-LICENSE.txt.part" "${_out}/icu-LICENSE.txt")
file(GLOB_RECURSE _files RELATIVE "${_out}" "${_out}/*")
set(_inventory "QtBase source: https://code.qt.io/qt/qtbase.git @ ${_revision}\nFramework modifications: none\n")
foreach(_file IN LISTS _files)
  if(NOT _file STREQUAL "SHA256SUMS.txt" AND NOT _file STREQUAL ".complete")
    file(SHA256 "${_out}/${_file}" _sha)
    string(APPEND _inventory "${_sha}  ${_file}\n")
  endif()
endforeach()
file(WRITE "${_out}/SHA256SUMS.txt" "${_inventory}")
file(WRITE "${_out}/.complete" "QtBase ${_revision}; ICU 73.2; Boost 1.86.0; GoogleTest pinned\n")
message(STATUS "Corresponding source and original notices ready: ${_out}")
