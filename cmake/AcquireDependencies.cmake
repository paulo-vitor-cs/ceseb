cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED CESEB_DEPS_ROOT)
  set(CESEB_DEPS_ROOT "build/dependencies")
endif()
get_filename_component(CESEB_DEPS_ROOT "${CESEB_DEPS_ROOT}" ABSOLUTE)
file(TO_CMAKE_PATH "${CESEB_DEPS_ROOT}" CESEB_DEPS_ROOT)
if(NOT CESEB_DEPS_ROOT MATCHES "/build/dependencies$")
  message(FATAL_ERROR "Refusing a dependency destination outside the declared build/dependencies tree")
endif()
if(NOT CESEB_DEPS_PLATFORM STREQUAL "linux" AND NOT CESEB_DEPS_PLATFORM STREQUAL "windows")
  message(FATAL_ERROR "CESEB_DEPS_PLATFORM must be linux or windows")
endif()
if(NOT DEFINED CESEB_ACQUIRE_QT)
  set(CESEB_ACQUIRE_QT OFF)
endif()
if(EXISTS "${CESEB_DEPS_ROOT}" AND NOT EXISTS "${CESEB_DEPS_ROOT}/.ceseb-owned")
  file(GLOB _existing "${CESEB_DEPS_ROOT}/*")
  if(_existing)
    message(FATAL_ERROR "Existing unowned dependency directory is preserved; reconcile it before reuse")
  endif()
endif()
file(MAKE_DIRECTORY "${CESEB_DEPS_ROOT}/downloads" "${CESEB_DEPS_ROOT}/logs")
file(WRITE "${CESEB_DEPS_ROOT}/.ceseb-owned" "ceseb dependency cache v1\n")
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.lock.json" _lock)
set_property(GLOBAL PROPERTY CESEB_ACQUIRED_RECORDS "")
function(record text)
  get_property(_records GLOBAL PROPERTY CESEB_ACQUIRED_RECORDS)
  list(APPEND _records "${text}")
  set_property(GLOBAL PROPERTY CESEB_ACQUIRED_RECORDS "${_records}")
endfunction()
function(download url name digest output)
  set(_file "${CESEB_DEPS_ROOT}/downloads/${name}")
  if(EXISTS "${_file}")
    file(SHA256 "${_file}" _actual)
    if(NOT _actual STREQUAL digest)
      message(FATAL_ERROR "Cached ${name} has unexpected SHA256; preserved for diagnosis")
    endif()
    message(STATUS "Verified cached ${name}")
  else()
    message(STATUS "Downloading approved ${name}")
    file(DOWNLOAD "${url}" "${_file}.part" TLS_VERIFY ON NETRC IGNORED
      EXPECTED_HASH "SHA256=${digest}" STATUS _status TIMEOUT 600 INACTIVITY_TIMEOUT 60)
    list(GET _status 0 _code)
    if(NOT _code EQUAL 0)
      message(FATAL_ERROR "Dependency download failed: ${name}: ${_status}")
    endif()
    file(RENAME "${_file}.part" "${_file}")
  endif()
  record("{\"url\":\"${url}\",\"archive\":\"${name}\",\"sha256\":\"${digest}\",\"verified\":true}")
  set(${output} "${_file}" PARENT_SCOPE)
endfunction()
function(extract archive destination digest)
  set(_marker "${destination}/.ceseb-extracted-${digest}")
  if(EXISTS "${_marker}")
    return()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _listing ERROR_VARIABLE _error)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Archive inventory unavailable: ${_error}")
  endif()
  string(REPLACE "\r\n" "\n" _listing "${_listing}")
  string(REPLACE "\n" ";" _entries "${_listing}")
  foreach(_entry IN LISTS _entries)
    string(REPLACE "\\" "/" _entry "${_entry}")
    if(_entry MATCHES "^/|^[A-Za-z]:|(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Unsafe archive path rejected before extraction: ${_entry}")
    endif()
  endforeach()
  file(MAKE_DIRECTORY "${destination}")
  message(STATUS "Extracting verified ${archive}")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
  file(WRITE "${_marker}" "${digest}\n")
endfunction()

string(JSON _boost_url GET "${_lock}" boost url)
string(JSON _boost_name GET "${_lock}" boost archive)
string(JSON _boost_hash GET "${_lock}" boost sha256)
download("${_boost_url}" "${_boost_name}" "${_boost_hash}" _boost_archive)
extract("${_boost_archive}" "${CESEB_DEPS_ROOT}" "${_boost_hash}")
if(NOT EXISTS "${CESEB_DEPS_ROOT}/boost_1_86_0/boost/version.hpp")
  message(FATAL_ERROR "Verified archive did not provide the selected Boost source prefix")
endif()

# GoogleTest is the separately approved immutable Git checkout, not an archive with an invented digest.
string(JSON _gtest_repository GET "${_lock}" googletest repository)
string(JSON _gtest_commit GET "${_lock}" googletest commit)
find_program(_git NAMES git REQUIRED)
set(_gtest_source "${CESEB_DEPS_ROOT}/googletest-src")
if(EXISTS "${_gtest_source}" AND NOT EXISTS "${_gtest_source}/.git")
  message(FATAL_ERROR "Unrecognized GoogleTest source directory preserved")
endif()
if(NOT EXISTS "${_gtest_source}/.git")
  file(MAKE_DIRECTORY "${_gtest_source}")
  execute_process(COMMAND "${_git}" -C "${_gtest_source}" init RESULT_VARIABLE _status OUTPUT_QUIET ERROR_VARIABLE _error)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "GoogleTest cache init failed: ${_error}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_TERMINAL_PROMPT=0 "${_git}" -C "${_gtest_source}" -c http.sslVerify=true fetch --depth=1 --no-tags "${_gtest_repository}" "${_gtest_commit}"
    RESULT_VARIABLE _status OUTPUT_FILE "${CESEB_DEPS_ROOT}/logs/gtest-fetch.log" ERROR_FILE "${CESEB_DEPS_ROOT}/logs/gtest-fetch-error.log")
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Exact GoogleTest fetch unavailable; inspect owned logs, no account is inferred")
  endif()
  execute_process(COMMAND "${_git}" -C "${_gtest_source}" checkout --detach "${_gtest_commit}" RESULT_VARIABLE _status OUTPUT_QUIET ERROR_VARIABLE _error)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "GoogleTest checkout failed: ${_error}")
  endif()
endif()
execute_process(COMMAND "${_git}" -C "${_gtest_source}" rev-parse HEAD RESULT_VARIABLE _status OUTPUT_VARIABLE _actual_commit OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _status EQUAL 0 OR NOT _actual_commit STREQUAL _gtest_commit)
  message(FATAL_ERROR "GoogleTest checkout does not match the approved commit")
endif()
execute_process(COMMAND "${_git}" -C "${_gtest_source}" status --porcelain OUTPUT_VARIABLE _gtest_dirty)
if(NOT _gtest_dirty STREQUAL "")
  message(FATAL_ERROR "GoogleTest source has local changes; refusing to overwrite or consume it")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_gtest_source}" -B "${CESEB_DEPS_ROOT}/googletest-build" -G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_INSTALL_PREFIX=${CESEB_DEPS_ROOT}/install" -DBUILD_GMOCK=OFF -DINSTALL_GTEST=ON -Dgtest_force_shared_crt=ON
  RESULT_VARIABLE _status OUTPUT_FILE "${CESEB_DEPS_ROOT}/logs/gtest-configure.log" ERROR_FILE "${CESEB_DEPS_ROOT}/logs/gtest-configure-error.log")
if(NOT _status EQUAL 0)
  message(FATAL_ERROR "GoogleTest configure failed; inspect dependency logs")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${CESEB_DEPS_ROOT}/googletest-build" --target install --parallel 2
  RESULT_VARIABLE _status OUTPUT_FILE "${CESEB_DEPS_ROOT}/logs/gtest-build.log" ERROR_FILE "${CESEB_DEPS_ROOT}/logs/gtest-build-error.log")
if(NOT _status EQUAL 0)
  message(FATAL_ERROR "GoogleTest build/install failed; inspect dependency logs")
endif()
record("{\"repository\":\"${_gtest_repository}\",\"commit\":\"${_actual_commit}\",\"verified\":true}")

if(CESEB_ACQUIRE_QT)
  string(JSON _count LENGTH "${_lock}" qt "${CESEB_DEPS_PLATFORM}")
  math(EXPR _last "${_count}-1")
  foreach(_i RANGE 0 ${_last})
    string(JSON _url GET "${_lock}" qt "${CESEB_DEPS_PLATFORM}" ${_i} url)
    string(JSON _name GET "${_lock}" qt "${CESEB_DEPS_PLATFORM}" ${_i} archive)
    string(JSON _hash GET "${_lock}" qt "${CESEB_DEPS_PLATFORM}" ${_i} sha256)
    download("${_url}" "${_name}" "${_hash}" _archive)
    extract("${_archive}" "${CESEB_DEPS_ROOT}/Qt" "${_hash}")
  endforeach()
  if(CESEB_DEPS_PLATFORM STREQUAL "windows")
    set(_kit msvc2022_64)
    set(_suffix .exe)
  else()
    set(_kit gcc_64)
    set(_suffix "")
  endif()
  set(_prefix "${CESEB_DEPS_ROOT}/Qt/6.12.0/${_kit}")
  if(NOT EXISTS "${_prefix}/lib/cmake/Qt6/Qt6Config.cmake")
    message(FATAL_ERROR "The SDK prefix is not at its selected location: ${_prefix}")
  endif()
  # A local relocation config belongs to this extracted cache, not to a modified Qt framework.
  if(NOT EXISTS "${_prefix}/bin/qt.conf")
    file(WRITE "${_prefix}/bin/qt.conf" "[Paths]\nPrefix=..\n")
    record("{\"configuration\":\"${_prefix}/bin/qt.conf\",\"purpose\":\"local SDK relocation\"}")
  endif()
  execute_process(COMMAND "${_prefix}/bin/qtpaths${_suffix}" --query QT_INSTALL_PREFIX RESULT_VARIABLE _status OUTPUT_VARIABLE _reported OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE _error)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Qt prefix query unavailable: ${_error}")
  endif()
  file(TO_CMAKE_PATH "${_reported}" _reported)
  if(NOT _reported STREQUAL _prefix)
    message(FATAL_ERROR "Qt relocation mismatch: expected ${_prefix}; observed ${_reported}")
  endif()
  if(CESEB_DEPS_PLATFORM STREQUAL "windows")
    execute_process(COMMAND "${_prefix}/bin/windeployqt.exe" --version RESULT_VARIABLE _status OUTPUT_VARIABLE _deploy_version ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
      message(FATAL_ERROR "windeployqt unavailable: ${_error}")
    endif()
  endif()
  record("{\"qt_prefix\":\"${_reported}\",\"version\":\"6.12.0\",\"build\":\"6.12.0-0-202609280346\"}")
endif()
get_property(_records GLOBAL PROPERTY CESEB_ACQUIRED_RECORDS)
list(JOIN _records ",\n" _records_json)
file(WRITE "${CESEB_DEPS_ROOT}/acquisition-manifest.json" "{\n\"platform\":\"${CESEB_DEPS_PLATFORM}\",\n\"qt_requested\":\"${CESEB_ACQUIRE_QT}\",\n\"records\":[\n${_records_json}\n]}\n")
message(STATUS "Approved dependencies ready in ${CESEB_DEPS_ROOT}; Qt requested: ${CESEB_ACQUIRE_QT}")
